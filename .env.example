# =====================================================================
#  Docker-оточення MenuOrder. Скопіюй у .env (make init це зробить).
#  Цей файл читають docker compose і Makefile.
#  Налаштування застосунку (APP_SECRET, Telegram) — в app/.env.
#  Значення з пробілами — тільки в лапках.
# =====================================================================

# --- Проєкт ----------------------------------------------------------
# Унікальне ім'я на твоїй машині: з нього беруться імена контейнерів,
# мережі, томів і образу.
COMPOSE_PROJECT_NAME=menuorder

# Базовий compose.yaml (app, nginx, cron, node) + MySQL.
COMPOSE_FILE=compose.yaml:docker/compose/mysql.yaml

# --- PHP-образ (зміни -> make build) -----------------------------------
PHP_VERSION=8.4
# curl уже є в офіційному образі. Список: github.com/mlocati/docker-php-extension-installer
PHP_EXTENSIONS="gd opcache pdo_mysql"
# 1 = вбудувати Xdebug в образ (make build). Сам режим вмикається нижче.
INSTALL_XDEBUG=0
# off | debug | coverage | debug,coverage — міняється без перезбирання (make up)
XDEBUG_MODE=off

# Твої UID/GID на хості (перевір: id -u && id -g).
PUID=1000
PGID=1000

# --- Порти ХОСТА (браузер, DataGrip, Vite) -------------------------------
# Контейнери між собою ходять по ВНУТРІШНІХ портах (3306), ці числа їх не стосуються.
HOST_APP_PORT=8080
HOST_DB_PORT=3307
HOST_VITE_PORT=5173

# --- База даних --------------------------------------------------------
# Ці змінні compose передає і в MySQL, і в контейнери app/cron (DB_HOST=db).
DB_NAME=menuorder
DB_USER=menuorder
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
# Тестова БД створюється поруч з основною: <DB_NAME><TEST_DB_SUFFIX> = menuorder_test.
TEST_DB_SUFFIX=_test
