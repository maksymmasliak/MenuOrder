# Application settings. Copy to app/.env (make init does it).
# Database access is NOT here: DB_* come from the root .env via compose.yaml.

APP_ENV=dev
APP_URL=http://localhost:8080
# HMAC for table QR codes and IP hashing.
# Generate with `openssl rand -hex 32` (64 hex chars). Minimum 32 characters,
# otherwise TableSigner throws an exception at startup.
APP_SECRET=changeme

TELEGRAM_BOT_TOKEN=
# Group chat id is negative, e.g. -1001234567890
TELEGRAM_CHAT_ID=
